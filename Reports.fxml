<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.application.Reports">

    <children>

        <Label text="Student Reports"/>

        <Label fx:id="totalGradesLabel" text="Total Grades:"/>
        <Label fx:id="averageLabel" text="Average Grade:"/>
        <Label fx:id="highestLabel" text="Highest Grade:"/>
        <Label fx:id="lowestLabel" text="Lowest Grade:"/>

        <Button text="Back" onAction="#handleBack"/>

    </children>

</VBox>