<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" prefHeight="400.0" prefWidth="500.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.application.AddGradesController">

    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <children>
        <Label text="Add Grades"/>

        <Label text="Student ID:"/>
        <ComboBox fx:id="studentComboBox" promptText="Select Student ID" prefWidth="250.0"/>

        <Label text="Course Name:"/>
        <TextField fx:id="courseField" promptText="Enter course name" maxWidth="250.0"/>

        <Label text="Score:"/>
        <TextField fx:id="scoreField" promptText="Enter score" maxWidth="250.0"/>

        <Button text="Save Grade" onAction="#handleSaveGrade" prefWidth="150.0"/>
        <Button text="Back" onAction="#handleBack" prefWidth="150.0"/>
    </children>
</VBox>